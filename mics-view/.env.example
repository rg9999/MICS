# Optional build-time overrides. If VITE_WS_URL is unset, the viewer connects to
# ws://<current-host>:8080 (the gateway's host-published port), so the same build
# works on any host without rebuilding. The in-app connection field also overrides.
VITE_WS_URL=
VITE_DATUM_LAT=32.0853
VITE_DATUM_LON=34.7818
VITE_DATUM_ALT=30.0
