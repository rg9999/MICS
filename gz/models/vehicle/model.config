<?xml version="1.0"?>
<model>
  <name>vehicle</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Generic MICS air vehicle for the Gazebo profile. Reused for both defenders
    and attackers: the VelocityControl and OdometryPublisher plugins derive
    their topics from the model's spawned instance name, so one SDF serves every
    entity. Driven by a commanded velocity (simple velocity plugin, not full
    rotor physics) per the Phase 1 integration plan.
  </description>
</model>
